# 只放私密配置。
# 程序会自动读取仓库根目录或 config 相邻目录中的 .env。

# NapCat / OneBot token。
QQBOT_QQ_ACCESS_TOKEN=

# 模型 API Key。
QQBOT_MAIN_MODEL_API_KEY=
QQBOT_GATE_MODEL_API_KEY=
QQBOT_VISION_MODEL_API_KEY=
QQBOT_EMBEDDING_MODEL_API_KEY=

# 基础设施密钥。示例值与 docker-compose.yml 的本地默认值保持一致。
QQBOT_STORAGE_MYSQL_PASSWORD=qqbotpass
QQBOT_STORAGE_REDIS_PASSWORD=
QQBOT_STORAGE_QDRANT_API_KEY=
QQBOT_STORAGE_MINIO_ACCESS_KEY=minioadmin
QQBOT_STORAGE_MINIO_SECRET_KEY=minioadmin123
